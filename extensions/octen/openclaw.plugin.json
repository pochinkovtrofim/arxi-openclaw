      "label": "Octen API Key",
      "sensitive": true
    },
    "webSearch.baseUrl": {
      "label": "Octen Search Base URL"
    }
  },
  "contracts": { "webSearchProviders": ["octen"] },
  "configGroups": [{ "id": "web-search", "title": "Web search", "order": 10, "properties": ["webSearch"] }],
